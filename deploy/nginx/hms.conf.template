# Nginx reverse-proxy template for the HMS VM (staging/production). Versioned baseline —
# copy to /etc/nginx/sites-available/hms.conf, substitute the ${...} placeholders, symlink
# into sites-enabled, and `nginx -t && systemctl reload nginx`. TLS terminates at Cloudflare
# in front (Full-Strict); an origin cert secures Cloudflare↔VM. See deploy/README.md.
#
# Routing:
#   ${PORTAL_HOST}      -> Portal (Next.js, PM2 hms-portal, :3000)
#   ${MARKETING_HOST}   -> Marketing (Next.js, PM2 hms-marketing, :3001)
#   ${API_HOST}         -> API (Express, PM2 hms-backend, :4000)

# Restore the real client IP from Cloudflare (so logs/rate-limits see the visitor, not CF).
# Keep the CF ranges current: https://www.cloudflare.com/ips/
real_ip_header CF-Connecting-IP;

upstream hms_backend  { server 127.0.0.1:4000; keepalive 16; }
upstream hms_portal   { server 127.0.0.1:3000; keepalive 16; }
upstream hms_marketing{ server 127.0.0.1:3001; keepalive 16; }

# --- API -------------------------------------------------------------------
server {
  listen 443 ssl http2;
  server_name ${API_HOST};

  ssl_certificate     ${SSL_CERT_PATH};
  ssl_certificate_key ${SSL_KEY_PATH};

  client_max_body_size 30m; # matches FILE_MAX_SIZE_MB headroom

  location / {
    proxy_pass http://hms_backend;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # Liveness/readiness for external uptime checks.
  location = /api/v1/health { proxy_pass http://hms_backend; access_log off; }
}

# --- Portal ----------------------------------------------------------------
server {
  listen 443 ssl http2;
  server_name ${PORTAL_HOST};

  ssl_certificate     ${SSL_CERT_PATH};
  ssl_certificate_key ${SSL_KEY_PATH};

  location / {
    proxy_pass http://hms_portal;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;         # Next.js HMR/websocket
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# --- Marketing (root domain) -----------------------------------------------
server {
  listen 443 ssl http2;
  server_name ${MARKETING_HOST};

  ssl_certificate     ${SSL_CERT_PATH};
  ssl_certificate_key ${SSL_KEY_PATH};

  location / {
    proxy_pass http://hms_marketing;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# Redirect any plain HTTP to HTTPS (Cloudflare also enforces this at the edge).
server {
  listen 80;
  server_name ${API_HOST} ${PORTAL_HOST} ${MARKETING_HOST};
  return 301 https://$host$request_uri;
}
