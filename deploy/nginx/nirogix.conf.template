# Nginx reverse-proxy template for the Nirogix VM (staging/production). Versioned baseline —
# copy to /etc/nginx/sites-available/nirogix.conf, substitute the ${...} placeholders, symlink
# into sites-enabled, and `nginx -t && systemctl reload nginx`. TLS terminates at Cloudflare
# in front (Full-Strict); an origin cert secures Cloudflare↔VM. See deploy/README.md.
#
# Hosts come from resources/domains.md — every one is second-level, so the `*.nirogix.com`
# certificate covers it:
#   Production  PORTAL_HOST=portal.nirogix.com          MARKETING_HOST=nirogix.com
#               API_HOST=api.nirogix.com
#   Staging     PORTAL_HOST=portal-staging.nirogix.com  MARKETING_HOST=staging.nirogix.com
#               API_HOST=api-staging.nirogix.com
#
# Routing:
#   ${PORTAL_HOST}      -> Portal (Next.js, PM2 nirogix-portal, :3000)
#   ${MARKETING_HOST}   -> Marketing (Next.js, PM2 nirogix-marketing, :3001)
#   ${API_HOST}         -> API (Express, PM2 nirogix-backend, :4000)

# Restore the real client IP from Cloudflare (so logs/rate-limits see the visitor, not CF).
# Keep the CF ranges current: https://www.cloudflare.com/ips/
real_ip_header CF-Connecting-IP;

upstream nirogix_backend  { server 127.0.0.1:4000; keepalive 16; }
upstream nirogix_portal   { server 127.0.0.1:3000; keepalive 16; }
upstream nirogix_marketing{ server 127.0.0.1:3001; keepalive 16; }

# --- API -------------------------------------------------------------------
server {
  listen 443 ssl http2;
  server_name ${API_HOST};

  ssl_certificate     ${SSL_CERT_PATH};
  ssl_certificate_key ${SSL_KEY_PATH};

  client_max_body_size 30m; # matches FILE_MAX_SIZE_MB headroom

  location / {
    proxy_pass http://nirogix_backend;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # Liveness/readiness for external uptime checks.
  location = /api/v1/health { proxy_pass http://nirogix_backend; access_log off; }
}

# --- Portal ----------------------------------------------------------------
server {
  listen 443 ssl http2;
  server_name ${PORTAL_HOST};

  ssl_certificate     ${SSL_CERT_PATH};
  ssl_certificate_key ${SSL_KEY_PATH};

  location / {
    proxy_pass http://nirogix_portal;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;         # Next.js HMR/websocket
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# --- Marketing (root domain) -----------------------------------------------
server {
  listen 443 ssl http2;
  server_name ${MARKETING_HOST};

  ssl_certificate     ${SSL_CERT_PATH};
  ssl_certificate_key ${SSL_KEY_PATH};

  location / {
    proxy_pass http://nirogix_marketing;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# --- www -> apex (production only) ------------------------------------------
# One canonical public URL. Serves nothing itself, so there is never a duplicate of
# the marketing site to index (resources/domains.md §2).
server {
  listen 443 ssl http2;
  server_name www.${MARKETING_HOST};

  ssl_certificate     ${SSL_CERT_PATH};
  ssl_certificate_key ${SSL_KEY_PATH};

  return 301 https://${MARKETING_HOST}$request_uri;
}

# --- Staging only -----------------------------------------------------------
# Uncomment on the staging VM. Belt-and-braces on top of each app's robots.ts: an
# indexed staging copy is both an SEO defect and a leak of unreleased copy. Access
# control (Cloudflare Access or basic auth) sits in front of all three hosts as well.
#
#   add_header X-Robots-Tag "noindex, nofollow" always;
#
# Add it inside each server block above, not here.

# Redirect any plain HTTP to HTTPS (Cloudflare also enforces this at the edge).
server {
  listen 80;
  server_name ${API_HOST} ${PORTAL_HOST} ${MARKETING_HOST};
  return 301 https://$host$request_uri;
}
