{
  "name": "hms",
  "version": "0.0.0",
  "private": true,
  "description": "Nirogix monorepo — Takoriya Technology LLP",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "hms_backend",
    "hms_frontend",
    "marketing",
    "admin",
    "patient",
    "aiportal",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=@hms/*",
    "test:api": "npm run test -w hms_backend -- api.test",
    "test:backend": "npm run test -w hms_backend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test --project=apps-smoke",
    "test:regression": "npm run test && npm run test:e2e",
    "typecheck": "turbo run typecheck",
    "openapi:generate": "turbo run openapi:generate",
    "openapi:validate": "turbo run openapi:validate",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
