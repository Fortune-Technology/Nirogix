# hms_frontend (Nirogix Portal) — copy to .env.local. Never commit .env.local.
# Host names for every environment come from resources/domains.md — never hard-code one.
#
# Base URL of the backend API (hms_backend).
#   Local   → http://localhost:4000/api/v1
#   Staging → https://api-staging.nirogix.com/api/v1
#   Prod    → https://api.nirogix.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# The admin console's origin. The ONLY sender the Portal accepts a support-session
# token from (ADR-051). Used to restrict, never to reach out.
#   Local   → http://localhost:3002
#   Staging → https://admin-staging.nirogix.com
#   Prod    → https://admin.nirogix.com
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3002

# The patient portal's origin. Used to compose the public patient-registration link
# a hospital prints on its QR poster (ADR-056) — a public URL by design.
#   Local   → http://localhost:3003
#   Staging → https://patient-staging.nirogix.com
#   Prod    → https://patient.nirogix.com
NEXT_PUBLIC_PATIENT_URL=http://localhost:3003

# Dev port is set via the `next dev -p 3000` script; override here only if needed.
