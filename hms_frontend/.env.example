# Nirogix Portal (:3001) — copy to .env and change the values. Every key below is live
# (never commented). Hosts per environment: resources/domains.md.

# Backend API base URL — the Portal's only backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# The admin console's exact origin — the only sender the Portal accepts a support-session
# token from (ADR-051). Used to restrict, never to reach out.
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3003

# The patient portal's origin — composes the public patient-registration link a hospital
# prints on its QR poster (ADR-056).
NEXT_PUBLIC_PATIENT_URL=http://localhost:3002

# development | staging | production (ADR-071). Baked in at build time; the sign-in
# quick-login switcher exists only in the first two and folds out of a production build.
NEXT_PUBLIC_ENVIRONMENT=development

# Set to `off` to hide the quick-login switcher in an environment that would otherwise show it.
# For when staging is being security-audited: one-click sign-in with committed credentials is a
# finding even when they are synthetic. Blank leaves the environment default above in charge.
NEXT_PUBLIC_QUICK_LOGIN=

# Seed password the quick-login switcher fills in. Synthetic, never a real credential.
NEXT_PUBLIC_DEV_LOGIN_PASSWORD='ChangeMe#123'
