# hms_frontend (Nirogix Portal) — copy to .env.local. Never commit .env.local.
# Host names for every environment come from resources/domains.md — never hard-code one.
#
# Base URL of the backend API (hms_backend).
#   Local   → http://localhost:4000/api/v1
#   Staging → https://api-staging.nirogix.com/api/v1
#   Prod    → https://api.nirogix.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# The admin console's origin. The ONLY sender the Portal accepts a support-session
# token from (ADR-051). Used to restrict, never to reach out.
#   Local   → http://localhost:3003
#   Staging → https://admin-staging.nirogix.com
#   Prod    → https://admin.nirogix.com
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3003

# The patient portal's origin. Used to compose the public patient-registration link
# a hospital prints on its QR poster (ADR-056) — a public URL by design.
#   Local   → http://localhost:3002
#   Staging → https://patient-staging.nirogix.com
#   Prod    → https://patient.nirogix.com
NEXT_PUBLIC_PATIENT_URL=http://localhost:3002

# Which of the three canonical environments this build is for (ADR-071). Exactly one of:
#   development → a developer's local machine       (quick-login switcher ENABLED)
#   staging     → the shared QA/demo deployment     (quick-login switcher ENABLED)
#   production  → the live product                  (switcher DISABLED; or leave unset)
# Enables the dev quick-login test-user switcher (issue #7) on the sign-in page for the two
# non-production environments. Baked in at build time (NEXT_PUBLIC_*), so a production build must
# be built WITHOUT a non-production value or the switcher would ship. It never weakens auth — it
# only pre-fills the same login form.
NEXT_PUBLIC_ENVIRONMENT=development

# Dev port is set via the `next dev -p 3001` script; override here only if needed.
