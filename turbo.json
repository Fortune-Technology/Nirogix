{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_TTL",
    "JWT_REFRESH_TTL",
    "CORS_ORIGINS",
    "PORT",
    "LOG_LEVEL",
    "SENTRY_DSN",
    "OPENAPI_TITLE",
    "API_VERSION",
    "API_PUBLIC_URL",
    "API_STAGING_URL",
    "API_PRODUCTION_URL",
    "OPENAPI_UI_ENABLED",
    "MSG91_API_KEY",
    "MSG91_SMS_SENDER_ID",
    "MSG91_EMAIL_FROM",
    "MSG91_EMAIL_DOMAIN",
    "MSG91_OTP_TEMPLATE_ID",
    "FILE_STORAGE_PROVIDER",
    "FILE_STORAGE_LOCAL_DIR",
    "FILE_MAX_SIZE_MB",
    "R2_ENDPOINT",
    "R2_REGION",
    "R2_BUCKET",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "REDIS_URL",
    "ANTHROPIC_API_KEY",
    "AI_DRAFT_MODEL",
    "BOOTSTRAP_PLATFORM_NAME",
    "BOOTSTRAP_ADMIN_EMAIL",
    "BOOTSTRAP_ADMIN_PASSWORD",
    "CONFIRM_PRODUCTION_SEED",
    "RATE_LIMIT_IN_DEV",
    "NEXT_PUBLIC_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "openapi:generate": {
      "cache": false
    },
    "openapi:validate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
