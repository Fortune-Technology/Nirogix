{
  "name": "@hms/permissions",
  "version": "0.0.0",
  "private": true,
  "description": "Dot-hierarchy permission keys (module.submodule.page.action) shared by hms_backend and hms_frontend — the single source of truth for permission strings.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hms/config": "*",
    "typescript": "^5"
  }
}
