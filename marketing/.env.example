# marketing site — copy to .env.local. Never commit .env.local.
# Host names for every environment come from resources/domains.md — never hard-code one.
#
# Which of the three canonical environments this build is for (ADR-071). Exactly one of
# development | staging | production. On staging it MUST be `staging` — that marks the public-DNS
# copy `noindex` so it is never indexed (marketing/lib/seo.ts). Unset behaves as development.
NEXT_PUBLIC_ENVIRONMENT=development

# This site's own public base URL. Drives `metadataBase`, canonicals, the sitemap, and
# every absolute URL in the JSON-LD, so it must match the environment it is serving.
#   Development → http://localhost:3000
#   Staging     → https://staging.nirogix.com
#   Production  → https://nirogix.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the "Login" action sends users — the Portal's login route.
#   Development → http://localhost:3001/login
#   Staging     → https://portal-staging.nirogix.com/login
#   Production  → https://portal.nirogix.com/login
NEXT_PUBLIC_PORTAL_LOGIN_URL=http://localhost:3001/login
# Dev port is set via the `next dev -p 3000` script; override here only if needed.
