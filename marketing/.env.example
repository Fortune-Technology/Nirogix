# Marketing site (:3000) — copy to .env and change the values. Every key below is live
# (never commented). Hosts per environment: resources/domains.md.

# development | staging | production (ADR-071). `staging` marks the public-DNS copy noindex.
NEXT_PUBLIC_ENVIRONMENT=development

# This site's own public base URL — drives metadataBase, canonicals, sitemap and JSON-LD,
# so it must match the environment it serves.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the "Login" action sends visitors — the Portal's login route.
NEXT_PUBLIC_PORTAL_LOGIN_URL=http://localhost:3001/login

# Backend API base URL, used only to allow that origin in the site's CSP connect-src.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Backend API base URL for server-side tenant-branding fetches. Server-only, never bundled.
HMS_API_URL=http://localhost:4000/api/v1
