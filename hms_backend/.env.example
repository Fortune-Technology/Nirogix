# Copy to .env and fill in. Never commit .env.
# Host names for every environment come from resources/domains.md — never hard-code one.
NODE_ENV=development
PORT=4000

# Allowed browser origins, comma-separated. REQUIRED in production (ADR-036) — an unset
# value is logged as an error rather than silently allowing everything; development is
# permissive because localhost ports move.
# Staging → https://portal-staging.nirogix.com,https://staging.nirogix.com
# Prod    → https://portal.nirogix.com,https://nirogix.com
# CORS_ORIGINS=

# PostgreSQL (managed E2E DBaaS in staging/prod; local Docker in dev)
DATABASE_URL=postgresql://hms:hms@localhost:5432/hms

# Auth — use long random strings in real environments (min 16 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Logging
LOG_LEVEL=info
# Error tracking (Sentry/GlitchTip). Leave unset to capture errors to the structured log
# (`error.captured` events). Set a DSN in staging/production to forward to the tracker.
# SENTRY_DSN=https://<key>@<host>/<project>

# OpenAPI / Swagger (environment-aware — do not hard-code URLs elsewhere)
OPENAPI_TITLE=Nirogix API
API_VERSION=1.0.0
# Base URL of THIS instance's API host. Defaults to http://localhost:${PORT} if unset.
# Local  → http://localhost:4000
# Staging→ https://api-staging.nirogix.com
# Prod   → https://api.nirogix.com
API_PUBLIC_URL=http://localhost:4000
# Optional extra servers shown in the Swagger UI dropdown (leave unset per environment).
# API_STAGING_URL=https://api-staging.nirogix.com
# API_PRODUCTION_URL=https://api.nirogix.com
# Serve the interactive Swagger UI in this environment (JSON spec is always served).
# Production sets this to false — the public reference lives on docs.nirogix.com.
OPENAPI_UI_ENABLED=true

# Notifications — MSG91 for SMS/WhatsApp AND email (ADR-016). Leave unset in dev to use the
# "log" provider (messages are logged, not sent). DLT/sender registration is a go-live
# prerequisite (24–48h operator approval). No module calls MSG91 directly.
# MSG91_API_KEY=
# MSG91_SMS_SENDER_ID=
# Sending identity lives on the mail subdomain, never the apex (resources/domains.md §2).
# MSG91_EMAIL_FROM=noreply@mail.nirogix.com
# MSG91_EMAIL_DOMAIN=mail.nirogix.com
# MSG91_EMAIL_FROM_NAME=Nirogix
# MSG91_EMAIL_TEMPLATE_ID=
#
# OTP (ADR-059). Codes are generated, hashed and verified by us today; these are for
# the managed MSG91 OTP flow if it is adopted later. Indian SMS additionally needs DLT
# registration — entity id plus an approved template per message type.
# MSG91_OTP_TEMPLATE_ID=
# MSG91_DLT_ENTITY_ID=
#
# NEVER commit a real value here, and never paste one into chat, a ticket or a commit.
# Supply them through the deployment's own secrets mechanism (ADR-059).

# File storage — 'local' (disk, dev) or 'r2' (Cloudflare R2, S3-compatible object storage; no AWS)
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_DIR=./storage
FILE_MAX_SIZE_MB=25
# For r2 (Cloudflare R2 — pin the bucket's jurisdiction to India for PHI):
# R2_ENDPOINT=<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_BUCKET=nirogix-documents          # nirogix-documents-staging in staging — never shared
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# AI prescription drafting (ADR-070). Leave unset to keep the feature absent — the Portal
# renders no AI control and the endpoint answers 404. Never commit a real key.
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# AI_DRAFT_MODEL=claude-sonnet-5
