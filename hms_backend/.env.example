# hms_backend API — copy to .env and change the values. Every key below is live (never commented);
# a blank value means "not configured" and falls back safely. Hosts per env: resources/domains.md.

# development | test | staging | production
NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed to call the API. Required in production (ADR-036).
CORS_ORIGINS=

# PostgreSQL — the system of record.
DATABASE_URL=postgresql://hms:hms@localhost:5432/hms
# Pool safety valves: longest a query may run, and longest a transaction may sit idle (M-2).
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TX_TIMEOUT_MS=15000

# Auth secrets — min 16 chars, long and random in any shared environment.
# Generate: node -p "require('node:crypto').randomBytes(32).toString('base64')"
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Sentry/GlitchTip DSN. Blank = errors captured to the structured log instead.
SENTRY_DSN=

# OpenAPI / Swagger. API_PUBLIC_URL is this instance's own host; the staging/production URLs
# only add entries to the Swagger server dropdown. Docs default to OFF in production (L-2).
OPENAPI_TITLE=Nirogix API
API_VERSION=1.0.0
API_PUBLIC_URL=http://localhost:4000
API_STAGING_URL=
API_PRODUCTION_URL=
OPENAPI_UI_ENABLED=true

# Frontend origins the backend composes links into (password-reset + welcome emails, ADR-081) —
# never derived from a request header. Staging and production must set all three.
PORTAL_URL=http://localhost:3001
ADMIN_URL=http://localhost:3003
# Patient-portal origin for "view in portal" links in patient emails. Blank = button omitted.
PATIENT_URL=http://localhost:3002

# MSG91 — the only provider for SMS and email (ADR-016, ADR-059). Blank API key = the "log"
# provider (messages logged, not sent). SMS also needs DLT-registered sender/template ids.
MSG91_API_KEY=
MSG91_EMAIL_FROM=noreply@mail.nirogix.com
MSG91_EMAIL_DOMAIN=mail.nirogix.com
MSG91_SMS_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
# Variable name inside that MSG91 flow. Blank = var1, MSG91's default for a single-variable flow.
MSG91_OTP_TEMPLATE_VAR=

# File storage — 'local' (disk) or 'r2' (Cloudflare R2). FILE_MAX_SIZE_MB is the RAW ceiling;
# images are optimized to <=1 MB after upload, so keep it big enough to accept a phone photo.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_DIR=./storage
FILE_MAX_SIZE_MB=10
# Required when FILE_STORAGE_PROVIDER=r2. Two buckets exist: nirogix-documents-staging (every
# non-production environment) and nirogix-documents (production only); boot fails on a mismatch.
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Redis for the BullMQ queue. Blank = jobs run inline in-process (fine for dev and CI).
REDIS_URL=

# AI prescription drafting (ADR-070). Blank key = the feature does not exist anywhere.
ANTHROPIC_API_KEY=
AI_DRAFT_MODEL=claude-sonnet-5

# Encryption at rest for stored bearer credentials (ADR-084). 32 bytes, base64 or 64-char hex.
# Generate: node -p "require('node:crypto').randomBytes(32).toString('base64')"
ENCRYPTION_KEY=

# ABDM / ABHA Milestone 1 (ADR-084). 'mock' works offline with a fixed OTP of 123456 and refuses
# to run in production; 'gateway' needs the NHA client pair below plus ENCRYPTION_KEY.
ABDM_PROVIDER=mock
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
# Sandbox hosts; NHA issues the production hosts after HTC approval and boot fails on a
# production/sandbox mismatch. The per-hospital HFR facility id is tenant data, not config.
ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
# Sandbox facility registry, where the HIP service is registered (npm run abdm:bridge).
# A different host from the gateway; NHA issues the production one after HTC approval.
ABDM_FACILITY_REGISTRY_URL=https://facilitysbx.abdm.gov.in
# National registry host for HFR + HPR (ABDM Milestone 4). Same session token as the gateway;
# only the base URL differs. NHA issues the production host after M4 approval.
ABDM_HFR_BASE_URL=https://apihspsbx.abdm.gov.in/v4/int
# Consent Manager id ('sbx' in sandbox), the consent-wording stamp, and how long a
# verification transaction stays usable.
# How inbound ABDM callbacks are authenticated: enforce | log | off.
# enforce verifies the bearer JWT against NHA's JWKS and refuses anything else. Use log ONLY to
# observe one real callback before enforcing; off disables the check and must never ship.
ABDM_CALLBACK_AUTH=enforce

ABDM_CM_ID=sbx
ABDM_CONSENT_VERSION=m1-v1
ABDM_TXN_TTL_SECONDS=600
# Path to the Fidelius CLI LAUNCHER SCRIPT (…/bin/fidelius-cli), never a jar: the release is a
# script plus a lib/ directory, so `java -jar` cannot work. Needs a JRE on the host.
# Blank disables record transfer — nothing is ever sent unencrypted.
FIDELIUS_CLI_PATH=
# Public base URL where other hospitals push records we requested (ABDM M3).
# Same host as the registered bridge URL. Blank disables requesting external history.
ABDM_HIU_PUSH_BASE_URL=
# How long NHA allows between a records request and its delivery. Lateness is audited.
ABDM_TRANSFER_SLA_SECONDS=1200
