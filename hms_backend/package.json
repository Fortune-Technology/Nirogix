{
  "name": "hms_backend",
  "version": "1.0.0",
  "private": true,
  "description": "Nirogix backend API (Node.js + Express + TypeScript + Drizzle). See resources/development-plan.md §9.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"[hms_backend] eslint added in the husky/lint step (Task 0.0)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:generate": "tsx src/scripts/openapi-generate.ts",
    "openapi:validate": "tsx src/scripts/openapi-validate.ts",
    "abdm:audit": "tsx src/scripts/abdm-audit.ts",
    "abdm:evidence": "tsx src/scripts/abdm-evidence.ts",
    "abdm:check": "tsx src/scripts/abdm-check.ts",
    "abdm:bridge": "tsx src/scripts/abdm-bridge.ts",
    "abdm:m2check": "tsx src/scripts/abdm-m2check.ts",
    "abdm:m3check": "tsx src/scripts/abdm-m3check.ts",
    "db:create": "tsx src/scripts/create-database.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:staging": "tsx src/scripts/seed.staging.ts",
    "db:seed:production": "tsx src/scripts/seed.production.ts",
    "files:migrate-r2": "tsx src/scripts/migrate-files-to-r2.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@hms/permissions": "*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.4",
    "multer": "^2.3.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "express-list-endpoints": "^6.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
