# AI Portal (nirogix.ai, :3004) — copy to .env.local. Never commit .env.local.
# Host names for every environment come from resources/domains.md — never hard-code one.
#
# Base URL of the backend API (hms_backend).
#   Local   → http://localhost:4000/api/v1
#   Staging → https://api-staging.nirogix.com/api/v1
#   Prod    → https://api.nirogix.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# The Nirogix Portal's origin — where someone who lands here but cannot get in is sent, rather
# than a dead end (the AI Portal gates on ai.portal.access, ADR-053).
#   Local   → http://localhost:3001
#   Staging → https://portal-staging.nirogix.com
#   Prod    → https://portal.nirogix.com
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# The marketing site's public base URL — the "back to the main site" destination.
#   Local   → http://localhost:3000
#   Staging → https://staging.nirogix.com
#   Prod    → https://nirogix.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev port is set via the `next dev -p 3004` script; override here only if needed.
# The AI Portal's own host is nirogix.ai in production (a separate registrable domain) and
# ai-staging.nirogix.com in staging (resources/domains.md §8); it is not needed in this app's env.
