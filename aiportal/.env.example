# AI Portal (:3004, nirogix.ai) — copy to .env and change the values. Every key below is
# live (never commented). Hosts per environment: resources/domains.md.

# Backend API base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# The Portal's origin — where anyone without `ai.portal.access` is sent (ADR-053).
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# The marketing site's public base URL — the "back to the main site" destination.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
