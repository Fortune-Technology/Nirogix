# Platform Admin console (:3003) — copy to .env and change the values. Every key below is
# live (never commented). Hosts per environment: resources/domains.md.

# Backend API base URL — the same one API every other surface uses.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# The Portal's exact origin — the console hands a support-session token to a Portal tab
# by postMessage (ADR-051), so it must name that origin precisely.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
