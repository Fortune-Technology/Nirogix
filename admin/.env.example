# admin console (Nirogix Platform Admin, :3003) — copy to .env.local. Never commit .env.local.
# Host names for every environment come from resources/domains.md — never hard-code one.
#
# Base URL of the backend API (hms_backend). The admin console talks to the same one backend
# as every other surface.
#   Local   → http://localhost:4000/api/v1
#   Staging → https://api-staging.nirogix.com/api/v1
#   Prod    → https://api.nirogix.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# The Nirogix Portal's origin. The admin app hands a support-session token to a Portal tab by
# postMessage (ADR-051), so it must name the Portal's exact origin — it never reaches out otherwise.
#   Local   → http://localhost:3001
#   Staging → https://portal-staging.nirogix.com
#   Prod    → https://portal.nirogix.com
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# Which of the three canonical environments this build is for (ADR-071). Exactly one of:
#   development | staging | production (or leave unset in production)
# Baked in at build time (NEXT_PUBLIC_*). The Admin console has NO test-credentials
# quick-login in ANY environment (ADR-077) — operators always type their real credentials.
NEXT_PUBLIC_ENVIRONMENT=development

# Dev port is set via the `next dev -p 3003` script; override here only if needed.
